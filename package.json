{
  "name": "dhuknoo-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "DHUKNOO Ride-Hailing Platform - Monorepo (Backend, Frontend, Shared Packages, Android)",
  "workspaces": [
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm run build --workspaces --if-present && npm --prefix backend run prisma:generate && npm --prefix backend run build",
    "build:backend": "npm --prefix backend run prisma:generate && npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:android": "npm --prefix frontend run android:sync",
    "start": "node backend/dist/server.js",
    "start:docker": "docker-compose up -d",
    "stop:docker": "docker-compose down",
    "install:all": "npm install && npm install --prefix backend",
    "install:backend": "npm install --prefix backend",
    "install:frontend": "npm install --prefix frontend",
    "clean": "npm cache clean --force",
    "clean:all": "npm run clean && rm -rf node_modules backend/node_modules frontend/node_modules packages/*/node_modules",
    "reinstall": "npm run clean:all && npm run install:all",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:migrate": "npm --prefix backend run prisma:migrate",
    "prisma:studio": "npm --prefix backend run prisma:studio",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "list": "npm ls --workspaces",
    "doctor": "npm doctor",
    "android:build": "npm --prefix frontend run android:sync",
    "android:open": "npm --prefix frontend run android:open",
    "android:sync": "npm --prefix frontend run android:sync"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "autoprefixer": "^10.5.4",
    "browserslist": "^4.28.6",
    "caniuse-lite": "^1.0.30001806",
    "postcss": "^8.5.19",
    "prisma": "^5.10.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "recharts": "^3.10.0",
    "socket.io": "^4.8.3",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rusyd73/21stDHUKNOO.git"
  },
  "author": "DHUKNOO Team",
  "license": "MIT"
}