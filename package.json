{
  "name": "dhuknoo-monorepo",
  "version": "23.1.6",
  "private": true,
  "workspaces": [
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:migrate": "npm --prefix backend run prisma:migrate",
    "test": "npm --prefix backend test",
    "build": "npm run prisma:generate && npm --prefix backend run build && npm --prefix frontend run build",
    "typecheck": "npm --prefix backend exec tsc --noEmit && npm --prefix frontend run typecheck",
    "verify:contract": "node scripts/verify-api-contract.mjs",
    "verify:driver-lifecycle": "node scripts/verify-driver-lifecycle.mjs",
    "verify:mart-contract": "node scripts/verify-mart-contract.mjs",
    "verify:frontend-css": "node scripts/verify-frontend-css.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
