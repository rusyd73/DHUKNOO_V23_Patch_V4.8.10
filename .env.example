# ============================================================
# DHUKNOO - Environment Variables Example
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================================
# BACKEND
# ============================================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
ALLOWED_ORIGINS=http://localhost:5173

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/dhuknoo

# ============================================================
# REDIS
# ============================================================
REDIS_URL=redis://localhost:6379

# ============================================================
# JWT
# ============================================================
JWT_SECRET=change_this_in_production_min_32_chars
JWT_REFRESH_SECRET=change_this_in_production_min_32_chars

# ============================================================
# SENTRY (Optional)
# ============================================================
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.05
SENTRY_ERRORS_ONLY=false

# ============================================================
# SMTP (Email)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=no-reply@dhuknoo.com

# ============================================================
# ADMIN
# ============================================================
ADMIN_WHATSAPP_NUMBER=6281252185515

# ============================================================
# METRICS (Prometheus)
# ============================================================
METRICS_TOKEN=change_this_in_production

# ============================================================
# FRONTEND (Vite)
# ============================================================
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000
GEMINI_API_KEY=your-gemini-api-key-if-needed

# ============================================================
# DOCKER (Optional)
# ============================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dhuknoo
POSTGRES_PORT=5432

# 🆕 Dipakai docker-compose.yml service `grafana` (GF_SECURITY_ADMIN_USER /
# GF_SECURITY_ADMIN_PASSWORD) -- sebelumnya di-hardcode langsung di
# docker-compose.yml ("admin" / "admin_ganti_ini"), sekarang wajib diisi di
# sini. JANGAN pakai nilai contoh ini di production.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_ganti_password_grafana_admin

REDIS_PASSWORD=change_me
REDIS_PORT=6379

BACKEND_PORT=3000
FRONTEND_PORT=5173
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@dhuknoo.com
PGADMIN_PASSWORD=change_me
# Dipakai docker-compose.yml service "grafana" -- sebelumnya hardcoded
# langsung di compose file (ter-commit ke git dalam plain text).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_before_deploy
