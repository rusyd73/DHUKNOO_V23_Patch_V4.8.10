datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  DRIVER
  ADMIN
  MERCHANT
}

enum OrderStatus {
  PENDING
  ACCEPTED
  ON_THE_WAY
  ARRIVED
  COMPLETED
  CANCELLED
}

enum ServiceType {
  BIKE
  CAR
  SEND
  MART
}

enum TransactionType {
  TOPUP
  PAYMENT
  EARNING
  MERCHANT_EARNING
  PLATFORM_FEE
  REFUND
  // Kredit manual admin ke user LAIN via POST /api/admin/wallet/credit
  // (satu-satunya jalur sah di luar antrean TopupRequest, wajib target
  // eksplisit + alasan, tidak bisa menyasar diri sendiri). Dipisah dari
  // TOPUP supaya jejak audit tetap jelas mana top-up biasa vs kredit
  // manual admin.
  ADMIN_CREDIT
}

enum PromoType {
  PERCENTAGE
  FIXED
}

enum PaymentMethod {
  WALLET
  CASH
  QRIS
  TRANSFER
  EWALLET
}

enum PaymentProofStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum DriverDocumentType {
  KTP_SELFIE
  STNK
  SIM
}

enum DriverDocumentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum TopupStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  fullName     String
  role         Role          @default(CUSTOMER)
  refreshToken String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  resetPasswordTokenHash String?
  resetPasswordExpires   DateTime?

  isActive            Boolean   @default(true)
  deactivatedAt       DateTime?
  deactivatedBy       String?
  deactivationReason  String?

  customerProfile CustomerProfile?
  driverProfile   DriverProfile?
  merchant        Merchant?
  wallet          Wallet?
  files           File[]

  logs            ActivityLog[]
  topupRequests   TopupRequest[]

  @@index([email])
  @@index([role, isActive])
  @@index([isActive, createdAt])
}

model CustomerProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber    String?
  avatarUrl      String?
  isAppInstalled Boolean  @default(true)
  createdAt      DateTime @default(now())
  orders         Order[]  @relation("CustomerOrders")

  @@index([phoneNumber])
  @@index([userId])
}

model DriverProfile {
  id             String      @id @default(uuid())
  userId         String      @unique
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber    String?
  vehiclePlate   String
  vehicleModel   String
  serviceType    ServiceType @default(BIKE)
  isOnline       Boolean     @default(false)
  latitude       Float?
  longitude      Float?
  isVerified     Boolean     @default(false)
  companionInstalled Boolean @default(true)
  autoAcceptEnabled  Boolean @default(false)
  createdAt      DateTime    @default(now())
  orders         Order[]     @relation("DriverOrders")
  reviews        Review[]
  documents      DriverDocument[]

  @@index([isOnline, isVerified, serviceType])
  @@index([isOnline, latitude, longitude])
  @@index([isVerified, isOnline])
  @@index([serviceType, isOnline])
  @@index([userId])
  @@index([vehiclePlate])
}

model DriverDocument {
  id            String                @id @default(uuid())
  driverId      String
  driver        DriverProfile         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type          DriverDocumentType
  imageUrl      String
  status        DriverDocumentStatus  @default(PENDING_REVIEW)
  reviewNote    String?
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime              @default(now())

  @@index([driverId, status])
  @@index([status, createdAt])
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Decimal  @default(0.00) @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@index([userId])
  @@index([balance])
}

model Transaction {
  id          String            @id @default(uuid())
  walletId    String
  wallet      Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type        TransactionType
  amount      Decimal           @db.Decimal(12, 2)
  description String
  orderId     String?
  order       Order?            @relation(fields: [orderId], references: [id])
  idempotencyKey String?        @unique
  createdAt   DateTime          @default(now())

  @@index([walletId, createdAt])
  @@index([type, createdAt])
  @@index([orderId])
  @@index([createdAt])
  @@index([walletId, type])
}

model Order {
  id           String      @id @default(uuid())
  serviceType  ServiceType @default(BIKE)
  status       OrderStatus @default(PENDING)
  price        Decimal     @db.Decimal(10, 2)
  discount     Decimal     @default(0.00) @db.Decimal(10, 2)
  isPaid       Boolean     @default(false)
  paymentMethod PaymentMethod @default(WALLET)
  acceptedAt   DateTime?

  pickupAddress  String
  pickupLat      Float
  pickupLng      Float
  dropoffAddress String
  dropoffLat     Float
  dropoffLng     Float
  distanceKm     Float       @default(0)

  customerId   String
  customer     CustomerProfile @relation("CustomerOrders", fields: [customerId], references: [id])

  driverId     String?
  driver       DriverProfile?  @relation("DriverOrders", fields: [driverId], references: [id])

  promoId      String?
  promo        Promo?          @relation(fields: [promoId], references: [id])

  merchantId   String?
  merchant     Merchant?       @relation(fields: [merchantId], references: [id])
  orderItems   OrderItem[]

  review       Review?
  transactions Transaction[]
  pricingHistory PricingHistory?
  paymentProof PaymentProof?
  chatMessages   ChatMessage[]
  ledgers      Ledger[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([driverId, status])
  @@index([customerId, createdAt])
  @@index([merchantId, status, createdAt])
  @@index([paymentMethod, isPaid])
  @@index([status, driverId, createdAt])
  @@index([pickupLat, pickupLng])
  @@index([createdAt])
  @@index([serviceType, status])
  @@index([acceptedAt])
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name       String
  price      Decimal  @db.Decimal(10, 2)
  quantity   Int      @default(1)
  subtotal   Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model PaymentProof {
  id            String              @id @default(uuid())
  orderId       String              @unique
  order         Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        PaymentMethod
  proofImageUrl String
  note          String?
  status        PaymentProofStatus  @default(PENDING_REVIEW)
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime            @default(now())

  @@index([status, createdAt])
  @@index([orderId])
}

model ChatMessage {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId   String
  senderRole Role
  message    String
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([senderId, createdAt])
}

model Promo {
  id           String    @id @default(uuid())
  code         String    @unique
  type         PromoType
  value        Decimal   @db.Decimal(10, 2)
  maxDiscount  Decimal?  @db.Decimal(10, 2)
  minOrderPrice Decimal  @default(0.00) @db.Decimal(10, 2)
  quota        Int       @default(0)
  usedCount    Int       @default(0)
  isActive     Boolean   @default(true)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  orders       Order[]

  @@index([code])
  @@index([isActive, expiresAt])
}

model Review {
  id        String   @id @default(uuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driverId  String
  driver    DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([driverId, rating])
  @@index([orderId])
}

model Merchant {
  id        String    @id @default(uuid())
  name      String
  category  String
  address   String
  latitude  Float
  longitude Float
  phone     String?
  imageUrl  String?
  isOpen    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  ownerId   String?   @unique
  owner     User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  products  Product[]
  orders    Order[]

  @@index([name])
  @@index([category, isOpen])
  @@index([latitude, longitude])
  @@index([ownerId])
}

model Product {
  id          String   @id @default(uuid())
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems  OrderItem[]

  @@index([merchantId, isAvailable])
  @@index([name])
  @@index([merchantId, createdAt])
}

model PlatformConfig {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

model PricingZone {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  polygon   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rules            PricingRule[]
  regionalPolicies RegionalPolicy[]

  @@index([name])
  @@index([isActive])
}

model PricingRule {
  id                 String       @id @default(uuid())
  zoneId             String?
  zone               PricingZone? @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  serviceType        ServiceType

  baseFare           Decimal      @db.Decimal(10, 2)
  pickupFee          Decimal      @db.Decimal(10, 2) @default(0)
  perKmFee           Decimal      @db.Decimal(10, 2)
  perMinuteWaitFee   Decimal      @db.Decimal(10, 2) @default(0)

  isActive           Boolean      @default(true)
  effectiveFrom      DateTime     @default(now())
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([zoneId, serviceType, isActive])
  @@index([serviceType, isActive])
  @@index([effectiveFrom])
}

model RegionalPolicy {
  id               String      @id @default(uuid())
  zoneId           String
  zone             PricingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  tollFee          Decimal     @db.Decimal(10, 2) @default(0)
  parkingFee       Decimal     @db.Decimal(10, 2) @default(0)
  weatherSurcharge Decimal     @db.Decimal(10, 2) @default(0)
  holidaySurcharge Decimal     @db.Decimal(10, 2) @default(0)

  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([zoneId, isActive])
}

model TariffVersion {
  id              String    @id @default(uuid())
  versionName     String    @unique
  description     String?

  commissionTiers Json

  isActive        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  activatedAt     DateTime?

  pricingHistories PricingHistory[]

  @@index([isActive])
  @@index([createdAt])
}

model PricingHistory {
  id              String         @id @default(uuid())
  orderId         String         @unique
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  tariffVersionId String?
  tariffVersion   TariffVersion? @relation(fields: [tariffVersionId], references: [id])

  breakdown       Json

  createdAt       DateTime       @default(now())

  @@index([orderId])
  @@index([tariffVersionId])
  @@index([createdAt])
}

model TopupRequest {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Decimal      @db.Decimal(12, 2)
  method        PaymentMethod
  proofImageUrl String?
  note          String?
  status        TopupStatus  @default(PENDING_REVIEW)
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime     @default(now())

  @@index([status, createdAt])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([method, status])
}

model Holiday {
  id        String   @id @default(uuid())
  date      DateTime @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([isActive])
}

model File {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String
  entityId     String
  originalName String
  path         String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([entityId])
  @@index([type])
  @@index([createdAt])
}

model Ledger {
  id          String   @id @default(uuid())
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  userId      String
  type        String
  amount      Decimal  @db.Decimal(12, 2)
  description String
  reference   String   @unique
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}