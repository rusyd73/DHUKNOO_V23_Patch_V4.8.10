NODE_ENV=development
PORT=3000

# ============================================================================
# WAJIB diisi untuk build Android (Capacitor) -- salin file ini jadi ".env"
# lalu isi dengan alamat backend yang bisa dijangkau dari HP Anda.
#
# Testing lokal (HP & komputer di WiFi yang sama): pakai IP LAN komputer
# Anda, BUKAN localhost/127.0.0.1 (itu akan merujuk ke HP itu sendiri, bukan
# ke komputer tempat backend berjalan).
#   Cara cek IP LAN:
#     Windows      : ipconfig            -> lihat "IPv4 Address"
#     Mac / Linux  : ifconfig | grep "inet "
#
# Untuk build web biasa (bukan Android), variabel ini boleh dikosongkan --
# otomatis fallback ke window.location.origin seperti sebelumnya.
# ============================================================================
VITE_API_BASE_URL=http://192.168.1.10:3000

